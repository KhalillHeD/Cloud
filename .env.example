# Copy to .env (python tasks.py setup does it). Never commit .env.
# AWS credentials do NOT go here: use ~/.aws/credentials (Learner Lab > AWS Details).

# --- AWS / deployment
AWS_REGION=us-east-1
# AWS_PROFILE=default
PROJECT_NAME=traffic-analytics
STACK_NAME=traffic-analytics
# Leave empty to use arn:aws:iam::<your account>:role/LabRole
LAB_ROLE_ARN=
# Build Lambdas in Docker when no local python3.11: auto | true | false
SAM_USE_CONTAINER=auto

# --- data / replay
N_SENSORS=50
# Real seconds between two replayed 5-minute slices: 300 = real time, 10 = demo
TICK_SECONDS=300
# clock = replay the dataset slot with the same weekday and time as now; cursor = start at REPLAY_START
REPLAY_MODE=clock
REPLAY_START=2012-03-05T06:00:00
SYNTHETIC_INCIDENT_RATE=0.002

# --- congestion levels (congestion_index = max(0, 1 - speed / free_flow))
FREEFLOW_PERCENTILE=85
LEVEL_MODERATE=0.2
LEVEL_HEAVY=0.4
LEVEL_SEVERE=0.6

# --- forecasting (minutes, multiples of 5)
FORECAST_HORIZONS=15,30,60

# --- alerts / agent
ALERT_EMAIL=
ALERT_DEDUP_MINUTES=30
# bedrock | anthropic | openai  (fallbacks read their key from Secrets Manager or the env var below)
LLM_PROVIDER=bedrock
# Empty = the model chosen by scripts/check_access.py
BEDROCK_MODEL_ID=
# LLM_API_KEY=            # only for local tests of the fallback; in AWS use Secrets Manager


# --- local mode (moto server started by `python tasks.py local`)
# AWS_ENDPOINT_URL=http://localhost:5000

# --- deployment options
# CloudFront in front of the dashboard (if the account allows it; slower first deploy)
USE_CLOUDFRONT=false
# Secrets Manager secret with an Anthropic/OpenAI key, used when Bedrock is blocked
LLM_API_KEY_SECRET_NAME=
